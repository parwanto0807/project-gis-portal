    "prisma:studio:hrm": "npx prisma studio --schema=prisma/hrm/schema.prisma",
    "prisma:validate": "npx prisma validate --schema=prisma/gis/schema.prisma && npx prisma validate --schema=prisma/hrm/schema.prisma",
