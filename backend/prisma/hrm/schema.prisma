generator hrm_client {
  provider = "prisma-client-js"
  output   = "../../src/generated/hrm"
}

datasource db {
  provider  = "postgresql"
  url       = env("HRM_DATABASE_URL")
  directUrl = env("HRM_DIRECT_URL")
}

model Account {
  id                String   @id
  userId            String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  type              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model User {
  id        String    @id
  email     String    @unique
  password  String?
  name      String?
  image     String?
  role      UserRole  @default(EMPLOYEE)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  isActive  Boolean   @default(true)
  fcmToken  String?
  Account   Account[]
  Session   Session[]
  karyawan  karyawan?
}

model Session {
  id           String   @id
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model company {
  id                            String        @id @db.Uuid
  KODE_CMPY                     String        @unique @db.Char(3)
  COMPANY                       String?
  ADDRESS1                      String?
  ADDRESS2                      String?
  ADDRESS3                      String?
  TLP                           String?       @db.VarChar(20)
  FAX                           String?       @db.VarChar(20)
  NPWP                          String?       @db.VarChar(20)
  DIRECTOR                      String?
  NPWPDIR                       String?       @db.VarChar(20)
  LOGO                          String?
  NPP                           String?       @db.VarChar(30)
  ASTEKBAYAR                    String?
  EMAIL                         String?       @db.VarChar(100)
  HOMEPAGE                      String?
  HRDMNG                        String?
  NPWPMNG                       String?       @db.VarChar(20)
  created_at                    DateTime      @default(now()) @db.Timestamp(6)
  updated_at                    DateTime      @db.Timestamp(6)
  dshift                        dshift[]
  gaji_gaji_KD_CMPYTocompany    gaji[]        @relation("gaji_KD_CMPYTocompany")
  gaji_gaji_company_idTocompany gaji[]        @relation("gaji_company_idTocompany")
  karyawan                      karyawan[]
  konfig_bpjs                   konfig_bpjs[]
  parameter                     parameter[]
  periode                       periode[]
  skala_upah                    skala_upah[]
  time_work                     time_work[]

  @@index([KODE_CMPY])
}

model karyawan {
  id                                             String                @id @db.Uuid
  user_id                                        String?               @unique
  EMPL_ID                                        String                @unique @db.VarChar(9)
  NIK                                            String?               @unique @db.VarChar(16)
  ID_ABSEN                                       String?               @db.VarChar(9)
  NAMA                                           String                @db.VarChar(50)
  KD_CMPY                                        String?               @db.Char(3)
  KD_FACT                                        String?               @db.VarChar(2)
  KD_BAG                                         String?               @db.VarChar(20)
  KD_DEPT                                        String?               @db.VarChar(20)
  KD_SEKSIE                                      String?               @db.VarChar(6)
  KD_PKT                                         String?               @db.VarChar(5)
  KD_JAB                                         String?               @db.VarChar(20)
  KD_AGM                                         String?               @db.VarChar(2)
  KD_SKL                                         String?               @db.VarChar(2)
  BANK_CODE                                      String?               @db.Char(2)
  KD_SEX                                         JenisKelamin?         @default(LAKILAKI)
  ALAMAT1                                        String?               @db.VarChar(100)
  ALAMAT2                                        String?               @db.VarChar(100)
  KOTA                                           String?               @db.VarChar(30)
  KD_POS                                         String?               @db.VarChar(5)
  TELPON                                         String?               @db.VarChar(16)
  HANDPHONE                                      String?               @db.VarChar(16)
  EMAIL                                          String?               @db.VarChar(50)
  TMP_LHR                                        String?               @db.VarChar(30)
  TGL_LHR                                        DateTime?             @db.Date
  TGL_ANGKAT                                     DateTime?             @db.Date
  KTPNO                                          String?               @db.VarChar(20)
  VALID_KTP                                      DateTime?             @db.Date
  NPWP                                           String?               @db.VarChar(20)
  TGL_NPWP                                       DateTime?             @db.Date
  TYPE_SIM                                       String?               @db.VarChar(2)
  NO_SIM                                         String?               @db.VarChar(20)
  VALID_SIM                                      DateTime?             @db.Date
  PASPORTNO                                      String?               @db.VarChar(20)
  KITASNO                                        String?               @db.VarChar(20)
  VALID_KITAS                                    DateTime?             @db.Date
  NOBPJSTK                                       String?               @db.VarChar(20)
  NOBPJSKES                                      String?               @db.VarChar(20)
  KD_BPJSTK                                      Boolean?              @default(true)
  KD_BPJSKES                                     Boolean?              @default(true)
  TGL_ASTEK                                      DateTime?             @db.Date
  BANK_UNIT                                      String?               @db.VarChar(30)
  BANK_REKNO                                     String?               @db.VarChar(20)
  BANK_REKNAME                                   String?               @db.VarChar(30)
  TGL_MSK                                        DateTime?             @db.Date
  TGL_OUT                                        DateTime?             @db.Date
  ALASAN_OUT                                     String?               @db.VarChar(100)
  KD_OUT                                         Boolean?              @default(false)
  KD_JNS                                         StatusKaryawan?       @default(TETAP)
  HARI_KERJA                                     Int?                  @default(5)
  GROUP_SHIFT                                    String?               @default("00") @db.VarChar(10)
  KD_GAJI                                        Int?                  @default(1)
  KD_WNI                                         Boolean?              @default(true)
  KD_STS                                         StatusAktif?          @default(AKTIF)
  TGL_NIKAH                                      DateTime?             @db.Date
  KD_PTKP                                        Int?                  @default(1)
  JMLANAK                                        Int?                  @default(0)
  KD_LMB                                         Boolean?              @default(true)
  KD_SPL                                         Boolean?              @default(true)
  KD_PJK                                         Boolean?              @default(true)
  TYPE_PJK                                       Int?                  @default(1)
  KD_JAM                                         String?               @default("A") @db.VarChar(2)
  KD_KOPERASI                                    Boolean?              @default(false)
  KDPT_RUMAH                                     Boolean?              @default(false)
  POT_RUMAH                                      Decimal?              @default(0) @db.Decimal(5, 0)
  TGL_KOPERASI                                   DateTime?             @db.Date
  No_ANGGOTA                                     String?               @db.VarChar(9)
  KD_SPSI                                        Boolean?              @default(false)
  UNIFORM1                                       String?               @db.Char(3)
  UNIFORM2                                       Decimal?              @default(0) @db.Decimal(4, 0)
  GLDARAH                                        String?               @db.VarChar(2)
  TINGGI                                         Decimal?              @default(0) @db.Decimal(3, 0)
  BERAT                                          Decimal?              @default(0) @db.Decimal(5, 2)
  POKOK_BLN                                      Decimal?              @default(0) @db.Decimal(12, 0)
  TTRANSPORT                                     Decimal?              @default(0) @db.Decimal(12, 0)
  KD_TRANSP                                      Boolean?              @default(true)
  TMAKAN                                         Decimal?              @default(0) @db.Decimal(12, 0)
  KD_MAKAN                                       Boolean?              @default(true)
  TJABATAN                                       Decimal?              @default(0) @db.Decimal(12, 0)
  TKELUARGA                                      Decimal?              @default(0) @db.Decimal(12, 0)
  TKOMUNIKASI                                    Decimal?              @default(0) @db.Decimal(12, 0)
  TKHUSUS                                        Decimal?              @default(0) @db.Decimal(12, 0)
  TLMBTETAP                                      Decimal?              @default(0) @db.Decimal(12, 0)
  FIXOTHER                                       Decimal?              @default(0) @db.Decimal(12, 0)
  NM_TEMAN                                       String?               @db.VarChar(30)
  ALM_TEMAN                                      String?               @db.VarChar(40)
  TLP_TEMAN                                      String?               @db.VarChar(12)
  HUB_TEMAN                                      String?               @db.VarChar(10)
  LOKASIPOTO                                     String?               @db.VarChar(100)
  KKNO                                           String?               @db.VarChar(20)
  IBUKANDUNG                                     String?               @db.VarChar(50)
  ALAMATDOM1                                     String?               @db.VarChar(200)
  ALAMATDOM2                                     String?               @db.VarChar(200)
  ImagesName                                     String?               @db.VarChar(100)
  ImagesSize                                     String?               @db.VarChar(50)
  created_by                                     String?               @db.VarChar(50)
  updated_by                                     String?               @db.VarChar(50)
  created_at                                     DateTime              @default(now()) @db.Timestamp(6)
  updated_at                                     DateTime              @db.Timestamp(6)
  deleted_at                                     DateTime?             @db.Timestamp(6)
  jnsJamKdJam                                    String?               @db.VarChar(2)
  SUPERIOR_ID                                    String?               @db.VarChar(9)
  SUPERIOR2_ID                                   String?               @db.VarChar(9)
  TGL_HABIS_KONTRAK                              DateTime?             @db.Date
  TGL_MULAI_KONTRAK                              DateTime?             @db.Date
  absent                                         absent[]
  approval_log                                   approval_log[]
  att_log                                        att_log[]
  dcuti                                          dcuti[]
  emergency_contact                              emergency_contact[]
  empl_shift_override                            empl_shift_override[]
  gaji                                           gaji[]
  hcuti                                          hcuti[]
  bank                                           bank?                 @relation(fields: [BANK_CODE], references: [BANK_CODE])
  groupshift                                     groupshift?           @relation(fields: [GROUP_SHIFT], references: [GROUP_SHIFT])
  mstagm                                         mstagm?               @relation(fields: [KD_AGM], references: [CKD_AGM])
  mstbag                                         mstbag?               @relation(fields: [KD_BAG], references: [CKD_BAG])
  company                                        company?              @relation(fields: [KD_CMPY], references: [KODE_CMPY])
  mstdept                                        mstdept?              @relation(fields: [KD_DEPT], references: [CKD_DEPT])
  mstfact                                        mstfact?              @relation(fields: [KD_FACT], references: [CKD_FACT])
  mstjab                                         mstjab?               @relation(fields: [KD_JAB], references: [CKD_JAB])
  mstpkt                                         mstpkt?               @relation(fields: [KD_PKT], references: [CKD_PKT])
  mstsie                                         mstsie?               @relation(fields: [KD_SEKSIE], references: [CKD_SIE])
  mstskl                                         mstskl?               @relation(fields: [KD_SKL], references: [CKD_SKL])
  karyawan_karyawan_SUPERIOR2_IDTokaryawan       karyawan?             @relation("karyawan_SUPERIOR2_IDTokaryawan", fields: [SUPERIOR2_ID], references: [EMPL_ID])
  other_karyawan_karyawan_SUPERIOR2_IDTokaryawan karyawan[]            @relation("karyawan_SUPERIOR2_IDTokaryawan")
  karyawan_karyawan_SUPERIOR_IDTokaryawan        karyawan?             @relation("karyawan_SUPERIOR_IDTokaryawan", fields: [SUPERIOR_ID], references: [EMPL_ID])
  other_karyawan_karyawan_SUPERIOR_IDTokaryawan  karyawan[]            @relation("karyawan_SUPERIOR_IDTokaryawan")
  jnsjam                                         jnsjam?               @relation(fields: [jnsJamKdJam], references: [KD_JAM])
  User                                           User?                 @relation(fields: [user_id], references: [id])
  karyawan_dokumen                               karyawan_dokumen[]
  keluarga                                       keluarga[]
  kerja                                          kerja[]
  kondite                                        kondite[]
  kontrak                                        kontrak[]
  kpi_employee                                   kpi_employee[]
  kursus                                         kursus[]
  leave_balance                                  leave_balance[]
  lembur                                         lembur[]
  medik_trans                                    medik_trans[]
  mutasi                                         mutasi[]
  pengajuan                                      pengajuan[]
  pesangon                                       pesangon?
  pinjamdet                                      pinjamdet[]
  pinjamhdr                                      pinjamhdr[]
  potongan                                       potongan[]
  pphthn                                         pphthn[]
  rapel                                          rapel[]
  saldo_medic                                    saldo_medic[]
  sekolah                                        sekolah[]
  sertifikasi                                    sertifikasi[]
  shift_allw                                     shift_allw[]
  surat_peringatan                               surat_peringatan[]
  sys_user                                       sys_user[]
  tunjangan                                      tunjangan[]

  @@index([KD_BAG])
  @@index([KD_CMPY])
  @@index([KD_DEPT])
  @@index([KD_JAB])
  @@index([KD_STS])
  @@index([NAMA])
  @@index([NIK])
  @@index([KD_FACT])
  @@index([KD_SEKSIE])
  @@index([TGL_MSK])
  @@index([TGL_OUT])
}

model mstdept {
  id                         String     @id @db.Uuid
  CKD_BAG                    String?    @db.VarChar(20)
  CKD_DEPT                   String     @unique @db.VarChar(20)
  CNM_DEPT                   String?    @db.VarChar(30)
  KETERANGAN                 String?    @db.VarChar(50)
  created_at                 DateTime   @default(now()) @db.Timestamp(6)
  updated_at                 DateTime   @db.Timestamp(6)
  gaji_gaji_KD_DEPTTomstdept gaji[]     @relation("gaji_KD_DEPTTomstdept")
  gaji_gaji_dept_idTomstdept gaji[]     @relation("gaji_dept_idTomstdept")
  karyawan                   karyawan[]
  mstbag                     mstbag?    @relation(fields: [CKD_BAG], references: [CKD_BAG])
  mstsie                     mstsie[]

  @@unique([CKD_BAG, CKD_DEPT])
  @@index([CKD_BAG])
}

model mstjab {
  id                       String     @id @db.Uuid
  CKD_JAB                  String     @unique @db.VarChar(20)
  CNM_JAB                  String?    @db.VarChar(30)
  NTJABATAN                Decimal?   @db.Decimal(12, 0)
  NTRANSPORT               Decimal?   @db.Decimal(12, 0)
  NSHIFT_ALL               Decimal?   @db.Decimal(12, 0)
  NPREMI_HDR               Decimal?   @db.Decimal(12, 0)
  PERSEN_RMH               Decimal?   @db.Decimal(5, 2)
  PERSEN_PPH               Decimal?   @db.Decimal(5, 2)
  KETERANGAN               String?    @db.VarChar(50)
  created_at               DateTime   @default(now()) @db.Timestamp(6)
  updated_at               DateTime   @db.Timestamp(6)
  gaji_gaji_KD_JABTomstjab gaji[]     @relation("gaji_KD_JABTomstjab")
  gaji_gaji_jab_idTomstjab gaji[]     @relation("gaji_jab_idTomstjab")
  karyawan                 karyawan[]
}

model mstbag {
  id                       String     @id @db.Uuid
  CKD_BAG                  String     @unique @db.VarChar(20)
  CNM_BAG                  String?    @db.VarChar(30)
  KETERANGAN               String?    @db.VarChar(50)
  created_at               DateTime   @default(now()) @db.Timestamp(6)
  updated_at               DateTime   @db.Timestamp(6)
  gaji_gaji_KD_BAGTomstbag gaji[]     @relation("gaji_KD_BAGTomstbag")
  gaji_gaji_bag_idTomstbag gaji[]     @relation("gaji_bag_idTomstbag")
  karyawan                 karyawan[]
  mstdept                  mstdept[]
  mstsie                   mstsie[]
}

model AccountEmail {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model absent {
  id                  String               @id @db.Uuid
  PERIODE             String               @default("") @db.VarChar(6)
  EMPL_ID             String               @db.VarChar(9)
  TGL_ABSEN           DateTime             @db.Date
  NIK                 String?              @db.VarChar(10)
  ID_ABSEN            String?              @db.VarChar(9)
  NAMA                String?              @db.VarChar(30)
  KD_CMPY             String?              @db.VarChar(3)
  KD_FACT             String?              @db.VarChar(2)
  KD_BAG              String?              @db.VarChar(2)
  KD_DEPT             String?              @db.VarChar(2)
  KD_SEKSIE           String?              @db.VarChar(6)
  KD_JAM              String?              @db.VarChar(2)
  GROUP_SHIFT         String?              @default("") @db.Char(2)
  STDMASUK            String?              @db.VarChar(5)
  STDKELUAR           String?              @db.VarChar(5)
  REALMASUK           String?              @db.VarChar(5)
  REALKELUAR          String?              @db.VarChar(5)
  JMASUK              String?              @db.VarChar(5)
  JKELUAR             String?              @db.VarChar(5)
  KD_LMB              Boolean?             @default(false)
  KD_SPL              Boolean?             @default(true)
  LEMBUR1             Decimal?             @default(0.00) @db.Decimal(6, 2)
  LEMBUR2             Decimal?             @default(0.00) @db.Decimal(6, 2)
  LEMBUR3             Decimal?             @default(0.00) @db.Decimal(6, 2)
  LEMBUR4             Decimal?             @default(0.00) @db.Decimal(6, 2)
  TOTKERJA            Decimal?             @default(0.00) @db.Decimal(6, 2)
  LAMBAT              Int?                 @default(0)
  CEPAT               Int?                 @default(0)
  KD_HARI             Int?                 @default(1)
  KD_ABSEN            String?              @default("H") @db.Char(1)
  KD_SHIF             Int?                 @default(1)
  MSK_LMB             String?              @db.VarChar(5)
  KLR_LMB             String?              @db.VarChar(5)
  TOT_LMB             Decimal?             @default(0.00) @db.Decimal(7, 2)
  KET_LMB             String?              @db.VarChar(30)
  FLAG_SHIFT          Boolean?             @default(false)
  FLAG_MEAL           Boolean?             @default(false)
  FLAG_SUSU           Boolean?             @default(false)
  KODE_DESC           String?              @default("") @db.VarChar(3)
  created_at          DateTime             @default(now()) @db.Timestamp(6)
  updated_at          DateTime             @db.Timestamp(6)
  special_period_id   String?              @db.Uuid
  shift_override_id   String?              @db.Uuid
  karyawan            karyawan             @relation(fields: [EMPL_ID], references: [EMPL_ID])
  jnsjam              jnsjam?              @relation(fields: [KD_JAM], references: [KD_JAM])
  desc_absen          desc_absen?          @relation(fields: [KODE_DESC], references: [KODE_DESC])
  periode             periode              @relation(fields: [PERIODE], references: [PERIODE_ID])
  empl_shift_override empl_shift_override? @relation(fields: [shift_override_id], references: [id])
  special_period      special_period?      @relation(fields: [special_period_id], references: [id])

  @@unique([EMPL_ID, TGL_ABSEN])
  @@index([EMPL_ID])
  @@index([KD_ABSEN])
  @@index([KD_LMB])
  @@index([PERIODE])
  @@index([TGL_ABSEN])
}

model approval_log {
  id          String        @id @db.Uuid
  pengajuanId String        @db.Uuid
  APPROVER_ID String        @db.VarChar(9)
  level       Int
  status      RequestStatus
  remarks     String?
  action_date DateTime      @default(now())
  karyawan    karyawan      @relation(fields: [APPROVER_ID], references: [EMPL_ID])
  pengajuan   pengajuan     @relation(fields: [pengajuanId], references: [id])
}

model att_log {
  id         String   @id @db.Uuid
  empl_id    String   @default("") @db.VarChar(11)
  nik        String   @default("") @db.VarChar(20)
  id_absen   String   @default("") @db.VarChar(9)
  tanggal    DateTime @default(now()) @db.Date
  jam        String   @default("") @db.Char(5)
  att_time   DateTime @default(now()) @db.Timestamp(6)
  status     String?  @default("0") @db.Char(1)
  lat        String?  @db.VarChar(50)
  long       String?  @db.VarChar(50)
  distance   Int?     @default(0)
  photo      String?  @db.VarChar(100)
  device     String?  @db.VarChar(100)
  cflag      String   @default("") @db.Char(1)
  created_at DateTime @default(now()) @db.Timestamp(6)
  karyawan   karyawan @relation(fields: [nik], references: [NIK])

  @@unique([nik, tanggal, jam, cflag])
  @@index([att_time])
  @@index([empl_id])
  @@index([nik])
  @@index([tanggal])
}

model bank {
  id         String     @id @db.Uuid
  BANK_CODE  String     @unique @db.Char(2)
  BANK_NAMA  String?    @db.VarChar(30)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @db.Timestamp(6)
  karyawan   karyawan[]
}

model bataspajak {
  id         String   @id @db.Uuid
  BATAS1     Decimal  @default(0) @db.Decimal(15, 0)
  BATAS2     Decimal  @default(0) @db.Decimal(15, 0)
  PERSEN     Decimal  @default(0.00) @db.Decimal(5, 2)
  tahun      Int      @default(2024)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)

  @@unique([BATAS1, BATAS2, tahun])
  @@index([tahun])
}

model batasthr {
  id         String   @id @db.Uuid
  BATAS1     Decimal  @default(0.0) @db.Decimal(4, 1)
  BATAS2     Decimal  @default(0.0) @db.Decimal(4, 1)
  PERSEN     Decimal  @default(0.00) @db.Decimal(5, 2)
  tahun      Int      @default(2024)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)

  @@unique([BATAS1, BATAS2, tahun])
  @@index([tahun])
}

model bulan {
  NO         String   @id @db.VarChar(2)
  NMBULAN    String   @default("") @db.VarChar(10)
  NMBULANPDK String   @default("") @db.VarChar(3)
  is_active  Boolean? @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)
}

model dcuti {
  id          String      @id @db.Uuid
  ID          String      @unique @db.VarChar(10)
  EMPL_ID     String?     @db.VarChar(9)
  TAHUN       Int?        @default(2000)
  NIK         String?     @db.VarChar(10)
  JNS_CUTI    Int?        @default(1)
  TGL_MULAI   DateTime?   @db.Date
  TGL_AKHIR   DateTime?   @db.Date
  CUTI_PAKAI  Int?        @default(0)
  KETERANGAN  String?     @default("") @db.VarChar(100)
  STATUS      StatusCuti? @default(PENDING)
  REMARK      String?     @default("") @db.VarChar(100)
  approved_by String?     @db.VarChar(50)
  approved_at DateTime?   @db.Timestamp(6)
  created_at  DateTime    @default(now()) @db.Timestamp(6)
  updated_at  DateTime    @db.Timestamp(6)
  karyawan    karyawan?   @relation(fields: [EMPL_ID], references: [EMPL_ID])

  @@index([EMPL_ID])
  @@index([STATUS])
  @@index([TAHUN])
  @@index([TGL_MULAI, TGL_AKHIR])
}

model desc_absen {
  id         String    @id @db.Uuid
  KODE_DESC  String    @unique @db.Char(3)
  KETERANGAN String?   @db.VarChar(30)
  color_code String?   @default("#000000") @db.VarChar(7)
  is_active  Boolean?  @default(true)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  updated_at DateTime  @db.Timestamp(6)
  absent     absent[]
  jnscuti    jnscuti[]
}

model dshift {
  id          String     @id @db.Uuid
  PERIODE     String     @db.VarChar(6)
  KD_CMPY     String     @db.VarChar(3)
  GROUP_SHIFT String     @db.VarChar(10)
  GROUP_NAME  String     @default("") @db.VarChar(30)
  SHIFT01     String?    @db.VarChar(5)
  SHIFT02     String?    @db.VarChar(5)
  SHIFT03     String?    @db.VarChar(5)
  SHIFT04     String?    @db.VarChar(5)
  SHIFT05     String?    @db.VarChar(5)
  SHIFT06     String?    @db.VarChar(5)
  SHIFT07     String?    @db.VarChar(5)
  SHIFT08     String?    @db.VarChar(5)
